{
  "name": "local-wiki-mcp",
  "version": "0.6.0",
  "description": "Local-first MCP search server for Markdown wiki knowledge bases, with no API keys or external services.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "local-first",
    "wiki",
    "codex",
    "cursor",
    "markdown",
    "search"
  ],
  "bin": {
    "local-wiki": "./src/cli.js",
    "local-wiki-mcp": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "test:eval": "node scripts/product-eval.js",
    "test:pack": "node scripts/verify-package.js",
    "test:soak": "node scripts/watch-soak.js --duration-ms 3000 --mutation-interval-ms 400 --watch-interval-ms 100",
    "eval:semantic": "node scripts/product-eval.js --variant-set semantic",
    "bench:scale": "node --expose-gc scripts/scale-bench.js",
    "index": "node src/cli.js index",
    "serve": "node src/cli.js serve",
    "smoke": "node src/cli.js smoke",
    "soak:watch": "node scripts/watch-soak.js",
    "pack:check": "npm pack --dry-run",
    "release:check": "node scripts/check-release.js --local",
    "release:check:publish": "node scripts/check-release.js",
    "release:notes": "node scripts/release-notes.js",
    "release:rollback-plan": "node scripts/rollback-plan.js",
    "ci": "npm test && npm run test:eval && npm run release:check && npm run test:pack"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "src/",
    "scripts/install-windows-watch.ps1",
    "scripts/local-wiki-watch.ps1",
    "scripts/scale-bench.js",
    "README.md",
    "README.en.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "TROUBLESHOOTING.md",
    "MIGRATION_FROM_QMD.md",
    "SECURITY.md",
    "RELEASING.md",
    "codex.config.example.toml",
    "cursor.mcp.example.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ScorpioRoy/local-wiki-mcp.git"
  },
  "homepage": "https://github.com/ScorpioRoy/local-wiki-mcp#readme",
  "bugs": {
    "url": "https://github.com/ScorpioRoy/local-wiki-mcp/issues"
  }
}
